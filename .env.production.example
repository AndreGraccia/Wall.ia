# Variáveis da API em produção (Render + Neon). Referência, não é lido por nada: os valores vão no painel do Render
# (Environment do serviço wallia-api). Nunca preencha este arquivo com valores reais nem o copie para o repositório.
# Passo a passo em docs/deploy-producao.md. Para a pilha Docker local, o modelo continua sendo .env.example.properties.

# --- Banco (Neon) ---------------------------------------------------------------------------------------------
# Connection string do Neon convertida para JDBC: host e banco na URL, usuário e senha separados.
# Use o endpoint direto (sem "-pooler"): o Flyway e o driver JDBC não combinam com o PgBouncer em modo transação.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-SEU-ENDPOINT.us-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5

# --- Segredos da aplicação ------------------------------------------------------------------------------------
# openssl rand -base64 64
JWT_SECRET=
# openssl rand -base64 32. Obrigatória em produção (ADR 0014). Perder a chave = perder as descrições cifradas.
DATA_ENCRYPTION_KEY=
# Só durante uma rotação (ADR 0016): chaves antigas separadas por vírgula.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- Frontend -------------------------------------------------------------------------------------------------
# Endereço público da Vercel, sem barra no fim. Precisa bater com o Origin do navegador ou o CORS recusa os POSTs.
FRONTEND_ORIGIN=https://SEU-PROJETO.vercel.app

# --- E-mail (código de 8 dígitos do cadastro) -----------------------------------------------------------------
# O plano free do Render bloqueia as portas 25, 465 e 587. Use a porta alternativa com STARTTLS:
#   Brevo:  MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=2525  usuário = login SMTP do painel, senha = chave SMTP
#   Resend: MAIL_HOST=smtp.resend.com       MAIL_PORT=2587  usuário = resend, senha = API key
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
# Remetente de um domínio verificado no provedor; sem isso o e-mail é recusado ou cai no spam.
MAIL_FROM=

# --- Opcionais ------------------------------------------------------------------------------------------------
# Web Push: vazio desliga. Gere o par uma vez (docs/guia-do-desenvolvedor.md) e não troque.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# Sem chave, os relatórios usam a análise local determinística.
GEMINI_API_KEY=

# --- Fixas (já no render.yaml) --------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k
# PORT é injetada pelo Render; não defina.

# --- Frontend (Vercel) ----------------------------------------------------------------------------------------
# Nenhuma variável: frontend/.env.production já fixa REACT_APP_API_URL=/api/v1.
